      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (source) (increase(pipoker_visits_total{env=\"$env\"}[$__range])) > 0)",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ]
    },
