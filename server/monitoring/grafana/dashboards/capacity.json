  "panels": [
    {
      "type": "stat",
      "title": "Headroom",
      "description": "What the busiest resource of the server has left. Below 30% it is time to think about a stronger server; the alerts fire before it runs out",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "pipoker:headroom:ratio"
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Busiest resource",
      "description": "The resource that runs out first: cpu, memory, disk, uplink and downlink (the home internet connection), prod_heap (memory of the PROD backend), container_memory (a container against its limit)",
