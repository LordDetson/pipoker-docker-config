    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Why people left, per hour",
      "description": "left: with the button or removed by someone; page_closed: closed or refreshed the page; connection_lost: didn't come back in time; restart: didn't come back after a backend restart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
