#!/bin/bash
# Deploys one service of an environment to the given image tag.
# Usage: ./deploy <qa|prod> <backend|web> <tag>
# Called over SSH by the GitHub Actions workflows of pipoker-app and pipoker-web.
set -euo pipefail

cd "$(dirname "$0")"

environment=${1:?Environment required: qa or prod}
service=${2:?Service required: backend or web}
tag=${3:?Image tag required}

case "$environment" in qa|prod) ;; *) echo "Unknown environment: $environment" >&2; exit 1 ;; esac
case "$service" in
	backend) tag_variable=BACKEND_TAG ;;
	web) tag_variable=WEB_TAG ;;
	*) echo "Unknown service: $service" >&2; exit 1 ;;
esac
if [[ ! "$tag" =~ ^[A-Za-z0-9._-]+$ ]]; then
	echo "Invalid tag: $tag" >&2
	exit 1
fi

env_file="$environment.env"
if [ ! -f "$env_file" ]; then
	echo "$env_file not found, create it from $environment.env.example" >&2
	exit 1
fi

# Remember the deployed tag so that a restart of the whole environment keeps it
if grep -q "^$tag_variable=" "$env_file"; then
	sed -i "s/^$tag_variable=.*/$tag_variable=$tag/" "$env_file"
else
	echo "$tag_variable=$tag" >> "$env_file"
fi

docker network inspect pipoker-edge > /dev/null 2>&1 || docker network create pipoker-edge
compose="docker compose --env-file $env_file -f compose.yml"
$compose pull "$service"
$compose up -d --build
docker image prune -f > /dev/null
echo "Deployed $service:$tag to $environment"
