PIPOKER_ENV=qa
BACKEND_TAG=qa
WEB_TAG=qa
# Page origins allowed to open a room WebSocket (comma-separated).
STOMP_ALLOWED_ORIGINS=https://qa.pipoker.app
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-me
MONGODB_APP_USERNAME=pipoker
MONGODB_APP_PASSWORD=change-me
BROKER_USERNAME=pipoker
BROKER_PASSWORD=change-me
# Feedback from the site becomes issues of a Jira project, PIP unless JIRA_PROJECT says another (see README.md, «Feedback»)
JIRA_URL=https://api.atlassian.com/ex/jira/1cc74e6d-a44c-46c1-9d56-7e869f0dcc9a
JIRA_EMAIL=
JIRA_API_TOKEN=
# The invisible human check of the feedback form (see README.md, «Feedback»). QA runs it with Cloudflare's test keys,
# which always pass unseen: the check works end to end, and the tests' browsers aren't taken for robots
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
