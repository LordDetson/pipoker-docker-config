# Each environment answers on every domain in its list (comma-separated) and gets a certificate for each.
# The first one is the site's own domain; the DuckDNS one keeps old links working.
PROD_DOMAIN=pipoker.app, pipoker.duckdns.org
QA_DOMAIN=qa.pipoker.app, pipoker-qa.duckdns.org
# Login for QA from outside the home network. The hash comes from:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains $ characters.
QA_USERNAME=dmitry
QA_PASSWORD_HASH='<hash>'
# Cloudflare API token scoped to Zone:DNS:Edit for the pipoker.app zone. Caddy uses it for a DNS-01 challenge
# so the pipoker.app and qa.pipoker.app certificates keep renewing once those domains sit behind the Cloudflare
# proxy. Create it at https://dash.cloudflare.com/profile/api-tokens (template "Edit zone DNS", zone pipoker.app).
# Leave it empty while the domains are "DNS only": they then get certificates with the default challenge.
CLOUDFLARE_API_TOKEN=
# Cloudflare Tunnel id, printed by `cloudflared tunnel create` (see the server README). With it set and the
# "tunnel" profile active (next line), the cloudflared service connects the tunnel and the home router needs no
# open ports. Leave both empty until the tunnel exists; without the profile the service is simply left out.
CLOUDFLARE_TUNNEL_ID=
# Turn the cloudflared service on for every compose command run here, not just the first — compose reads this
# from the env file. It matters once the router ports are closed and the tunnel is the only way in: a plain
# `docker compose up -d` (manual or on reboot) then keeps cloudflared up instead of leaving it out. Uncomment
# once the tunnel is created:
# COMPOSE_PROFILES=tunnel
