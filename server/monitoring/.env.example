# Where the dashboard opens, used by Grafana for its links
GRAFANA_ROOT_URL=https://qa.pipoker.app/grafana/
# Nobody signs in to Grafana, but its admin account still needs a password of its own:
#   openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=change-me

# Capacity alerts (see rules/capacity.yml) go to Telegram and by email.
# The same bot and chat as the Monitor PROD workflow will do: the token comes from @BotFather,
# the chat id from https://api.telegram.org/bot<token>/getUpdates after writing to the bot
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
# Where the email goes, and the mailbox it is sent from. For Gmail the password is an app password
# (Google account → Security → 2-Step Verification → App passwords), not the account's own password
ALERT_EMAIL=change-me@gmail.com
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_USERNAME=change-me@gmail.com
SMTP_PASSWORD=change-me
