    {
      "id": 16,
      "type": "bargauge",
      "title": "Visits by source",
      "description": "Start page opens in the selected period by where people came from: the from parameter of the link (habr, tg, vk, boosty, alternativeto, saashub, producthunt, video, github), otherwise the referring site, otherwise direct. other_link is a from value nobody handed out, other_site a site not in the list",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
